---
import { withBase } from '../../lib/paths';
import SeriesModal from './SeriesModal.astro';

const itemClass =
	'group chrono-hover inline-flex items-center justify-center gap-2 bg-volt px-4 py-3 font-archive text-xs font-700 uppercase tracking-[0.18em] text-white hover:bg-volt/90 md:px-5';

const links = [
	{ label: 'Events', href: withBase('/events') },
	{ label: 'The Series', modal: 'series' as const },
	{ label: 'Past Results', href: withBase('/results') },
	{ label: 'Leaderboard', href: withBase('/leaderboard') },
	{ label: 'Volunteer', href: withBase('/volunteer') },
	{ label: 'Awards', href: withBase('/awards') },
];
---

<section id="explore" class="surface-void px-5 pb-16 md:px-10 md:pb-24">
	<div class="mx-auto max-w-[1600px]">
		<nav
			class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"
			aria-label="Explore IntoTri"
		>
			{
				links.map((link) => {
					const inner = (
						<>
							<span class="whitespace-nowrap">{link.label}</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="14"
								height="14"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="shrink-0 transition-transform duration-120 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
								aria-hidden="true"
							>
								<path d="M7 7h10v10"></path>
								<path d="M7 17 17 7"></path>
							</svg>
						</>
					);

					if ('href' in link) {
						return (
							<a href={link.href} class={itemClass} data-cursor="target">
								{inner}
							</a>
						);
					}

					return (
						<button
							type="button"
							class:list={[itemClass, 'border-0']}
							data-cursor="target"
							data-series-modal-open
							aria-haspopup="dialog"
							aria-controls="series-modal"
						>
							{inner}
						</button>
					);
				})
			}
		</nav>
	</div>
</section>

<SeriesModal />
