---
import { withBase } from '../../lib/paths';

const links = [
	{ label: 'Events', href: withBase('/events') },
	{ label: 'The Series', href: withBase('/series') },
	{ label: 'Past Results', href: withBase('/results') },
	{ label: 'Leaderboard', href: withBase('/leaderboard') },
	{ label: 'Volunteer', href: withBase('/volunteer') },
	{ label: 'Awards', href: withBase('/awards') },
];
---

<section id="explore" class="surface-void px-5 pb-16 md:px-10 md:pb-24">
	<div class="mx-auto max-w-[1600px]">
		<nav
			class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"
			aria-label="Explore IntoTri"
		>
			{
				links.map(({ label, href }) => (
					<a
						href={href}
						class="group chrono-hover inline-flex items-center justify-center gap-2 bg-volt px-4 py-3 font-archive text-xs font-700 uppercase tracking-[0.18em] text-white hover:bg-volt/90 md:px-5"
						data-cursor="target"
					>
						<span class="whitespace-nowrap">{label}</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="shrink-0 transition-transform duration-120 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
							aria-hidden="true"
						>
							<path d="M7 7h10v10"></path>
							<path d="M7 17 17 7"></path>
						</svg>
					</a>
				))
			}
		</nav>
	</div>
</section>
