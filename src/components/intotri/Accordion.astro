---
interface Props {
	title: string;
	open?: boolean;
	name?: string;
	class?: string;
}

const { title, open = false, name, class: className } = Astro.props;
const hairline = 'border-[hsl(var(--oxygen)/0.12)]';
---

<details
	class:list={['intotri-accordion group border-b', hairline, className]}
	name={name}
	open={open || undefined}
>
	<summary
		class="chrono-hover flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-oxygen marker:content-none hover:text-volt focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-volt md:py-8 [&::-webkit-details-marker]:hidden"
		data-cursor="target"
	>
		<span
			class="font-archive text-xs font-700 uppercase tracking-[0.18em] lg:text-xl lg:font-900 lg:leading-[0.9] lg:tracking-tighter2 lg:[word-spacing:0.24em] xl:text-2xl"
		>
			{title}
		</span>
		<span
			class:list={[
				'relative grid h-10 w-10 shrink-0 place-items-center border text-oxygen group-hover:border-volt group-hover:text-volt group-open:border-volt group-open:text-volt',
				hairline,
			]}
			aria-hidden="true"
		>
			<span class="absolute h-px w-3 bg-current"></span>
			<span
				class="absolute h-3 w-px bg-current transition-transform duration-120 group-open:scale-y-0"
			></span>
		</span>
	</summary>
	<div class="pb-8">
		<slot />
	</div>
</details>

<style>
	.intotri-accordion {
		interpolate-size: allow-keywords;
	}

	.intotri-accordion::details-content {
		block-size: 0;
		overflow: clip;
		opacity: 0;
		transition:
			block-size 200ms ease-out,
			opacity 120ms linear,
			content-visibility 200ms allow-discrete;
	}

	.intotri-accordion[open]::details-content {
		block-size: auto;
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.intotri-accordion::details-content {
			transition: none;
		}
	}
</style>
