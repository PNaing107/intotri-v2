---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Partner } from '../../data/partners';

interface Props {
	partner: Partner;
}

const { partner } = Astro.props;

const logos = import.meta.glob<ImageMetadata>(
	'/src/assets/partners/*.{png,jpg,jpeg,webp,avif}',
	{ import: 'default', eager: true },
);
const logo = logos[`/src/${partner.url}`];
const widths = logo ? [240, 320, 480, 640].filter((width) => width <= logo.width) : [];
const hairline = 'border-[hsl(var(--oxygen)/0.12)]';
---

<article class:list={['surface-void flex flex-col border md:flex-row md:items-center', hairline]}>
	<div
		class:list={[
			'flex w-full items-center justify-center border-b px-5 py-6 md:w-64 md:flex-none md:self-stretch md:border-b-0 md:border-r md:px-6 md:py-5',
			hairline,
		]}
	>
		{
			logo && (
				<Image
					src={logo}
					alt={`${partner.name} logo`}
					widths={widths.length ? widths : [logo.width]}
					sizes="(min-width: 768px) 256px, 100vw"
					loading="lazy"
					class="h-auto w-full object-contain md:h-28 md:w-auto md:max-h-28 md:max-w-[13rem]"
				/>
			)
		}
	</div>

	<div class="min-w-0 w-full flex-1 px-5 py-5 md:px-8 md:py-7">
		<h2 class="font-archive text-lg font-700 uppercase tracking-[0.08em] text-oxygen md:text-xl">
			{partner.slogan}
		</h2>
		<p class="mt-3 max-w-3xl font-body text-[15px] leading-[1.6] text-oxygen/80 md:text-base">
			{partner.description}
		</p>
	</div>
</article>
