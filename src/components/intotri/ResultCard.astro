---
import type { Result } from '../../data/results';

interface Props {
	result: Result;
}

const { result } = Astro.props;

const hasUrl = Boolean(result.url);
const Tag = hasUrl ? 'a' : 'div';

const date = new Date(`${result.date}T00:00:00Z`);
const day = date.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' });
const monthYear = date.toLocaleDateString('en-GB', {
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});

const hairline = 'border-[hsl(var(--oxygen)/0.12)]';
---

<Tag
	href={hasUrl ? result.url : undefined}
	target={hasUrl ? '_blank' : undefined}
	rel={hasUrl ? 'noopener noreferrer' : undefined}
	class:list={[
		'group surface-void flex h-full flex-col border',
		hairline,
		hasUrl && 'chrono-hover',
	]}
	data-cursor={hasUrl ? 'target' : undefined}
	aria-label={hasUrl ? `View results for ${result.name} (opens in a new tab)` : undefined}
>
	<div class:list={['flex items-center gap-6 border-b px-5 py-4', hairline]}>
		<time datetime={result.date} class="data-mono flex flex-col text-oxygen">
			<span class="text-xl font-700 leading-none">{day}</span>
			<span class="mt-1 text-[10px] font-500 uppercase tracking-[0.22em] text-oxygen/60">
				{monthYear}
			</span>
		</time>

		{
			result.description && (
				<p class="data-mono flex items-center gap-2 text-[11px] font-500 uppercase tracking-[0.18em] text-blu">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="13"
						height="13"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="shrink-0"
						aria-hidden="true"
					>
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					{result.description}
				</p>
			)
		}
	</div>

	<div class:list={['border-b px-5 pb-5 pt-6', hairline]}>
		<h2
			class:list={[
				'font-archive text-xl font-900 uppercase leading-[0.9] tracking-tighter2 text-oxygen md:text-2xl',
				hasUrl && 'chrono-hover group-hover:text-volt',
			]}
		>
			{result.name}
		</h2>
	</div>

	<div class="mt-auto px-5 pb-5 pt-5">
		{
			hasUrl ? (
				<span class="chrono-hover flex items-center justify-center gap-2 bg-volt px-5 py-4 font-archive text-xs font-700 uppercase tracking-[0.18em] text-white group-hover:bg-volt/90">
					View results
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="shrink-0 transition-transform duration-120 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						aria-hidden="true"
					>
						<path d="M7 7h10v10" />
						<path d="M7 17 17 7" />
					</svg>
				</span>
			) : (
				<span
					class:list={[
						'flex items-center justify-center border px-5 py-4 font-archive text-xs font-700 uppercase tracking-[0.18em] text-oxygen/50',
						hairline,
					]}
				>
					Results pending
				</span>
			)
		}
	</div>
</Tag>
