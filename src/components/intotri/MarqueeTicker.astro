---
const items = [
	'Next Event: Bodmin Triathlon - 23 Aug 2026',
	'Entries closing 18 Aug 2026',
	'All ages & abilities',
	'Volunteers wanted',
];

const track = Array.from({ length: 3 }, () => items).flat();
---

<aside
	class="group overflow-hidden bg-oxygen"
	aria-label="Event updates"
>
	<div
		data-marquee-track
		class="flex w-max animate-marquee group-hover:[animation-play-state:paused]"
	>
		{
			[false, true].map((duplicate) => (
				<ul
					class="flex shrink-0 items-center"
					aria-hidden={duplicate ? 'true' : undefined}
				>
					{track.map((item) => (
						<li class="data-mono flex shrink-0 items-center gap-8 py-3 pl-8 text-[10px] font-500 uppercase tracking-[0.22em] text-void md:py-3.5 md:text-[11px]">
							<span class="whitespace-nowrap">{item}</span>
							<span class="h-1.5 w-1.5 shrink-0 bg-volt" aria-hidden="true"></span>
						</li>
					))}
				</ul>
			))
		}
	</div>
</aside>

<style>
	@media (prefers-reduced-motion: reduce) {
		[data-marquee-track] {
			animation: none;
			width: 100%;
			flex-wrap: wrap;
			justify-content: center;
		}

		[data-marquee-track] ul[aria-hidden='true'] {
			display: none;
		}

		[data-marquee-track] ul {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
