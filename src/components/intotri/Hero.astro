---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import mobileFalSwimStart from '../../assets/slideshow/mobile/faltri-102.jpg';
import mobileFalSwim from '../../assets/slideshow/mobile/faltri-095.jpg';
import mobileAggieRun from '../../assets/slideshow/mobile/Aggie52026-182.jpg';
import mobileFalRun from '../../assets/slideshow/mobile/faltri-367.jpg';
import mobileFalPodium from '../../assets/slideshow/mobile/faltri-599.jpg';

import desktopKernowmanSwim from '../../assets/slideshow/desktop/kernowman26swim-44.jpg';
import desktopKernowmanRun from '../../assets/slideshow/desktop/kernowman26-395.jpg';
import desktopKernowmanBeach from '../../assets/slideshow/desktop/kernowman26-394.jpg';
import desktopFalSwimStart from '../../assets/slideshow/desktop/faltri-118.jpg';
import desktopKernowmanTransition from '../../assets/slideshow/desktop/kernowman26-11.jpg';

type Slide = {
	mobile: {
		image: ImageMetadata;
		label: string;
		/** Tailwind text colour utility for the label. */
		labelColor: string;
		/** Crop focus when the source is squeezed into the 9:16 mobile frame. */
		position?: 'left' | 'center' | 'right';
	};
	desktop: {
		image: ImageMetadata;
		label: string;
		labelColor: string;
	};
};

const alt = 'IntoTri multi-sport events in Cornwall';
const slideInterval = 3000;

const slides: Slide[] = [
	{
		mobile: {
			image: mobileFalSwimStart,
			label: 'Gylly Beach - Falmouth',
			labelColor: 'text-oxygen/70',
			position: 'left',
		},
		desktop: {
			image: desktopKernowmanSwim,
			label: "St Michael's Mount - Marazion",
			labelColor: 'text-oxygen/70',
		},
	},
	{
		mobile: {
			image: mobileFalSwim,
			label: 'Gylly Beach - Falmouth',
			labelColor: 'text-oxygen/70',
		},
		desktop: {
			image: desktopKernowmanRun,
			label: "St Michael's Mount - Marazion",
			labelColor: 'text-oxygen/70',
		},
	},
	{
		mobile: {
			image: mobileAggieRun,
			label: 'St Agnes',
			labelColor: 'text-white/70',
		},
		desktop: {
			image: desktopKernowmanBeach,
			label: "Mount's Bay - Marazion",
			labelColor: 'text-oxygen/70',
		},
	},
	{
		mobile: {
			image: mobileFalRun,
			label: 'Falmouth',
			labelColor: 'text-black/70',
		},
		desktop: {
			image: desktopFalSwimStart,
			label: 'Gylly Beach - Falmouth',
			labelColor: 'text-oxygen/70',
		},
	},
	{
		mobile: {
			image: mobileFalPodium,
			label: 'Falmouth',
			labelColor: 'text-white/70',
		},
		desktop: {
			image: desktopKernowmanTransition,
			label: "St Michael's Mount - Marazion",
			labelColor: 'text-white/70',
		},
	},
];

const mobileWidths = [480, 768, 1080];

const heroSlides = await Promise.all(
	slides.map(async (slide) => {
		const mobileImages = await Promise.all(
			mobileWidths.map((width) =>
				getImage({
					src: slide.mobile.image,
					width,
					height: Math.round(width * (16 / 9)),
					fit: 'cover',
					position: slide.mobile.position ?? 'center',
					format: 'webp',
				}),
			),
		);

		const desktopImage = await getImage({
			src: slide.desktop.image,
			width: 2560,
			widths: [1280, 1920, 2560],
			format: 'webp',
		});

		const mobileFallback = mobileImages[mobileImages.length - 1];

		return {
			mobileSrcset: mobileImages
				.map((image, index) => `${image.src} ${mobileWidths[index]}w`)
				.join(', '),
			mobileSrc: mobileFallback.src,
			width: mobileFallback.attributes.width,
			height: mobileFallback.attributes.height,
			desktopSrcset: desktopImage.srcSet.attribute,
			mobileLabel: slide.mobile.label,
			mobileLabelColor: slide.mobile.labelColor,
			desktopLabel: slide.desktop.label,
			desktopLabelColor: slide.desktop.labelColor,
		};
	}),
);
---

<section aria-label="IntoTri">
	<div
		id="hero"
		class="relative isolate min-h-dvh overflow-hidden bg-slatefriction"
		data-slide-interval={slideInterval}
	>
		<div class="absolute inset-0" aria-hidden="true">
			<div data-hero-media class="h-full w-full origin-center will-change-transform">
				{
					heroSlides.map((slide, index) => (
						<picture
							class="absolute inset-0 block"
							data-hero-slide
							data-active={index === 0 ? '' : undefined}
						>
							<source
								media="(min-width: 768px)"
								srcset={index === 0 ? slide.desktopSrcset : undefined}
								data-srcset={slide.desktopSrcset}
								sizes="100vw"
							/>
							<img
								src={index === 0 ? slide.mobileSrc : undefined}
								srcset={index === 0 ? slide.mobileSrcset : undefined}
								data-src={slide.mobileSrc}
								data-srcset={slide.mobileSrcset}
								sizes="100vw"
								alt={alt}
								width={slide.width}
								height={slide.height}
								class="h-full w-full max-w-none object-cover object-[center_30%] md:object-[center_42%]"
								loading={index === 0 ? 'eager' : 'lazy'}
								decoding={index === 0 ? 'sync' : 'async'}
								fetchpriority={index === 0 ? 'high' : 'low'}
							/>
						</picture>
					))
				}
			</div>
			<div
				data-hero-overlay
				class="absolute inset-0 bg-void pointer-events-none"
			>
			</div>
			<div
				class="absolute inset-x-0 top-0 h-[45%] bg-gradient-to-b from-void/35 to-transparent md:from-void/15 pointer-events-none"
			>
			</div>
		</div>

		<div class="relative z-10 mx-auto max-w-[1600px] px-5 pt-24 md:px-10 md:pt-32">
			<p class="data-mono relative h-4 text-[10px] font-500 uppercase tracking-[0.22em] md:h-5 md:text-[11px]">
				{
					heroSlides.map((slide, index) => (
						<span
							class="absolute inset-x-0 top-0"
							data-hero-caption
							data-active={index === 0 ? '' : undefined}
						>
							<span class:list={['md:hidden', slide.mobileLabelColor]}>/ {slide.mobileLabel}</span>
							<span class:list={['hidden md:inline', slide.desktopLabelColor]}>/ {slide.desktopLabel}</span>
						</span>
					))
				}
			</p>
		</div>
	</div>

	<div class="surface-void px-5 pt-16 pb-8 md:px-10 md:pt-24 md:pb-10">
		<div class="mx-auto max-w-[1600px]">
			<h1 class="relative mx-auto w-fit max-w-full px-5 py-4 text-center font-archive text-2xl font-700 leading-[1.2] tracking-tighter2 text-oxygen before:pointer-events-none before:absolute before:left-0 before:top-0 before:h-7 before:w-7 before:border-l-2 before:border-t-2 before:border-volt before:content-[''] after:pointer-events-none after:absolute after:bottom-0 after:right-0 after:h-7 after:w-7 after:border-b-2 after:border-r-2 after:border-volt after:content-[''] md:px-6 md:py-5 md:text-4xl md:before:h-8 md:before:w-8 md:after:h-8 md:after:w-8">
				Multi-sport events and running races based in the South West
			</h1>
		</div>
	</div>
</section>

<script>
	const hero = document.getElementById('hero');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (hero && !reduceMotion.matches) {
		let ticking = false;

		const update = () => {
			const { top, height } = hero.getBoundingClientRect();
			const progress = Math.min(1, Math.max(0, -top / Math.max(height, 1)));
			hero.style.setProperty('--hero-p', progress.toFixed(4));
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);

		update();
	}

	if (hero && !reduceMotion.matches) {
		const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
		const captions = [
			...hero.querySelectorAll<HTMLElement>('[data-hero-caption]'),
		];
		const interval = Number(hero.dataset.slideInterval) || 6000;

		if (slides.length > 1) {
			let current = 0;
			let timer: number | undefined;
			let visible = true;

			const load = (index: number) => {
				const slide = slides[index];
				if (!slide || slide.dataset.loaded !== undefined) return;

				const source = slide.querySelector('source');
				if (source?.dataset.srcset) source.srcset = source.dataset.srcset;

				const img = slide.querySelector('img');
				if (img?.dataset.srcset) img.srcset = img.dataset.srcset;
				if (img?.dataset.src) img.src = img.dataset.src;

				slide.dataset.loaded = '';
			};

			const show = (index: number) => {
				slides[current].removeAttribute('data-active');
				captions[current]?.removeAttribute('data-active');
				current = index;
				slides[current].setAttribute('data-active', '');
				captions[current]?.setAttribute('data-active', '');
				load((current + 1) % slides.length);
			};

			const start = () => {
				if (timer !== undefined) return;
				timer = window.setInterval(
					() => show((current + 1) % slides.length),
					interval,
				);
			};

			const stop = () => {
				if (timer === undefined) return;
				window.clearInterval(timer);
				timer = undefined;
			};

			load(0);
			load(1);

			document.addEventListener('visibilitychange', () => {
				if (document.hidden || !visible) stop();
				else start();
			});

			new IntersectionObserver((entries) => {
				visible = entries[0].isIntersecting;
				if (visible && !document.hidden) start();
				else stop();
			}).observe(hero);
		}
	}
</script>

<style>
	#hero {
		--hero-p: 0;
	}

	#hero [data-hero-media] {
		transform: scale(calc(1.06 + (var(--hero-p) * 0.1)));
	}

	#hero [data-hero-overlay] {
		opacity: calc(var(--hero-p) * 0.5);
	}

	#hero [data-hero-slide],
	#hero [data-hero-caption] {
		opacity: 0;
		transition: opacity 1200ms ease-in-out;
	}

	#hero [data-hero-slide][data-active],
	#hero [data-hero-caption][data-active] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		#hero [data-hero-media] {
			transform: none;
		}

		#hero [data-hero-overlay] {
			opacity: 0;
		}

		#hero [data-hero-slide],
		#hero [data-hero-caption] {
			transition: none;
		}
	}
</style>
