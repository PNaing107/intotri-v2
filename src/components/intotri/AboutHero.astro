---
import { getImage } from 'astro:assets';
import finishArch from '../../assets/fal_finish_arch_2023.jpg';
import soloPodium from '../../assets/faltri-solo-podium.jpg';

const alt = 'IntoTri at Falmouth — a smiling athlete with a finish towel, and the race finish arch on Gyllyngvase Beach';
const mobileWidths = [480, 768, 1080];

const mobileImages = await Promise.all(
	mobileWidths.map((width) =>
		getImage({
			src: soloPodium,
			width,
			height: Math.round(width * (16 / 9)),
			fit: 'cover',
			position: 'center',
			format: 'webp',
		}),
	),
);

const desktopImage = await getImage({
	src: finishArch,
	width: 2560,
	widths: [1280, 1920, 2560],
	format: 'webp',
});

const mobileFallback = mobileImages[mobileImages.length - 1];
const mobileSrcset = mobileImages
	.map((image, index) => `${image.src} ${mobileWidths[index]}w`)
	.join(', ');
---

<section
	id="about-hero"
	class="relative isolate min-h-dvh overflow-hidden bg-slatefriction"
	aria-label="IntoTri at Falmouth"
>
	<div class="absolute inset-0" aria-hidden="true">
		<div data-hero-media class="h-full w-full origin-center will-change-transform">
			<picture class="absolute inset-0 block">
				<source
					media="(min-width: 768px)"
					srcset={desktopImage.srcSet.attribute}
					sizes="100vw"
				/>
				<img
					src={mobileFallback.src}
					srcset={mobileSrcset}
					sizes="100vw"
					alt={alt}
					width={mobileFallback.attributes.width}
					height={mobileFallback.attributes.height}
					class="h-full w-full max-w-none object-cover object-center"
					loading="eager"
					decoding="sync"
					fetchpriority="high"
				/>
			</picture>
		</div>
		<div data-hero-overlay class="pointer-events-none absolute inset-0 bg-void"></div>
		<div
			class="pointer-events-none absolute inset-x-0 top-0 h-[45%] bg-gradient-to-b from-void/35 to-transparent md:from-void/15"
		>
		</div>
	</div>

	<div class="relative z-10 mx-auto max-w-[1600px] px-5 pt-24 md:px-10 md:pt-32">
		<p class="data-mono text-[10px] font-500 uppercase tracking-[0.22em] text-oxygen/80 md:text-[11px]">
			/ Gylly Beach — Falmouth
		</p>
	</div>
</section>

<script>
	const hero = document.getElementById('about-hero');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (hero && !reduceMotion.matches) {
		let ticking = false;

		const update = () => {
			const { top, height } = hero.getBoundingClientRect();
			const progress = Math.min(1, Math.max(0, -top / Math.max(height, 1)));
			hero.style.setProperty('--hero-p', progress.toFixed(4));
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);

		update();
	}
</script>

<style>
	#about-hero {
		--hero-p: 0;
	}

	#about-hero [data-hero-media] {
		transform: scale(calc(1.06 + (var(--hero-p) * 0.1)));
	}

	#about-hero [data-hero-overlay] {
		opacity: calc(var(--hero-p) * 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		#about-hero [data-hero-media] {
			transform: none;
		}

		#about-hero [data-hero-overlay] {
			opacity: 0;
		}
	}
</style>
