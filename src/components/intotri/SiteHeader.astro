---
import { Image } from 'astro:assets';
import logo from '../../assets/intoTri_logo_flag.png';

const navLinks = [
	{ label: 'Events', href: '/events' },
	{ label: 'The TRIbe', href: '/join-the-tribe' },
	{ label: 'About', href: '/about' },
	{ label: 'Partners', href: '/partners' },
];

const findEventHref = '/#upcoming-events';

const currentPath = Astro.url.pathname;
---

<header
	id="site-header"
	class="fixed inset-x-0 top-0 z-50 chrono-transition"
	data-scrolled="false"
>
	<div class="h-1 bg-volt" aria-hidden="true"></div>

	<div
		class="border-b border-transparent bg-transparent chrono-transition backdrop-blur-none"
		data-header-bar
	>
		<div class="mx-auto flex h-16 max-w-[1600px] items-stretch px-5 md:h-[4.5rem] md:px-10">
			<a
				href="/"
				class="chrono-hover flex shrink-0 items-center self-stretch py-1"
				aria-label="IntoTri home"
			>
				<Image
					src={logo}
					alt="IntoTri"
					class="h-full w-auto object-contain"
					loading="eager"
				/>
			</a>

			<nav
				class="ml-6 hidden items-center gap-8 md:ml-10 md:flex lg:gap-10"
				aria-label="Main navigation"
			>
				{
					navLinks.map(({ label, href }) => (
						<a
							href={href}
							class:list={[
								'group relative font-archive text-xs font-600 uppercase tracking-[0.14em] text-oxygen chrono-hover',
								currentPath === href && 'text-volt',
							]}
						>
							{label}
							<span class="absolute -bottom-1 left-0 h-px w-0 bg-volt chrono-hover group-hover:w-full" />
						</a>
					))
				}
			</nav>

			<div class="ml-auto flex items-center gap-3 md:gap-4">
				<a
					href={findEventHref}
					class="chrono-hover hidden items-center gap-2 bg-volt px-5 py-3 font-archive text-xs font-700 uppercase tracking-[0.18em] text-white hover:bg-volt/90 md:inline-flex"
					data-cursor="target"
				>
					Find Your Event
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="transition-transform duration-120 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						aria-hidden="true"
					>
						<path d="M7 7h10v10"></path>
						<path d="M7 17 17 7"></path>
					</svg>
				</a>

				<button
					type="button"
					class="chrono-hover inline-flex h-10 w-10 items-center justify-center border border-[hsl(var(--oxygen)/0.12)] text-oxygen md:hidden"
					aria-expanded="false"
					aria-controls="mobile-nav"
					data-mobile-toggle
				>
					<span class="sr-only">Toggle menu</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						data-icon-menu
					>
						<path d="M4 5h16"></path>
						<path d="M4 12h16"></path>
						<path d="M4 19h16"></path>
					</svg>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="hidden"
						aria-hidden="true"
						data-icon-close
					>
						<path d="M18 6 6 18"></path>
						<path d="m6 6 12 12"></path>
					</svg>
				</button>
			</div>
		</div>

		<div
			id="mobile-nav"
			class="hidden border-t border-[hsl(var(--oxygen)/0.12)] px-5 pb-5 md:hidden"
			data-mobile-nav
		>
			<nav class="flex flex-col gap-1 pt-4" aria-label="Mobile navigation">
				{
					navLinks.map(({ label, href }) => (
						<a
							href={href}
							class:list={[
								'font-archive py-3 text-sm font-600 uppercase tracking-[0.14em] text-oxygen chrono-hover',
								currentPath === href && 'text-volt',
							]}
						>
							{label}
						</a>
					))
				}
				<a
					href={findEventHref}
					class="chrono-hover mt-3 inline-flex items-center justify-center gap-2 bg-volt px-5 py-3 font-archive text-xs font-700 uppercase tracking-[0.18em] text-white"
					data-cursor="target"
				>
					Find Your Event
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M7 7h10v10"></path>
						<path d="M7 17 17 7"></path>
					</svg>
				</a>
			</nav>
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const headerBar = header?.querySelector('[data-header-bar]');
	const mobileToggle = header?.querySelector('[data-mobile-toggle]');
	const mobileNav = header?.querySelector('[data-mobile-nav]');
	const iconMenu = header?.querySelector('[data-icon-menu]');
	const iconClose = header?.querySelector('[data-icon-close]');

	const scrolledClasses = [
		'border-[hsl(var(--oxygen)/0.12)]',
		'bg-[hsl(var(--void)/0.85)]',
		'backdrop-blur-md',
	];
	const transparentClasses = [
		'border-transparent',
		'bg-transparent',
		'backdrop-blur-none',
	];

	function setScrolled(scrolled: boolean) {
		if (!header || !headerBar) return;

		header.dataset.scrolled = String(scrolled);
		headerBar.classList.remove(...(scrolled ? transparentClasses : scrolledClasses));
		headerBar.classList.add(...(scrolled ? scrolledClasses : transparentClasses));
	}

	function onScroll() {
		setScrolled(window.scrollY > 24);
	}

	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	function setMobileOpen(isOpen: boolean) {
		if (!mobileNav || !mobileToggle) return;
		mobileNav.classList.toggle('hidden', !isOpen);
		mobileToggle.setAttribute('aria-expanded', String(isOpen));
		iconMenu?.classList.toggle('hidden', isOpen);
		iconClose?.classList.toggle('hidden', !isOpen);
	}

	mobileToggle?.addEventListener('click', () => {
		setMobileOpen(mobileNav?.classList.contains('hidden') === true);
	});

	mobileNav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMobileOpen(false));
	});
</script>

<style>
	#site-header[data-scrolled='true'] [data-header-bar] {
		box-shadow: 0 1px 0 hsl(var(--oxygen) / 0.06);
	}

	#site-header[data-scrolled='false'] [data-header-bar] a:not([class*='bg-volt']),
	#site-header[data-scrolled='false'] [data-header-bar] button {
		text-shadow: 0 1px 8px hsl(var(--void) / 0.65);
	}
</style>
