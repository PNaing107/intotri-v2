---
interface Props {
	volunteerHref: string;
	enterHref: string;
	eventName?: string;
}

const { volunteerHref, enterHref, eventName } = Astro.props;

const buttonClass =
	'chrono-hover flex items-center justify-center px-4 py-4 font-archive text-xs font-700 uppercase tracking-[0.18em] text-white';
---

<style>
	:global(body) {
		padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
	}
</style>

<nav
	class="fixed inset-x-0 bottom-0 z-40 border-t border-[hsl(var(--oxygen)/0.12)] bg-void px-5 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 md:px-10"
	aria-label="Event call to action"
>
	<div class="mx-auto grid max-w-[1600px] grid-cols-2 gap-3">
		<a
			href={volunteerHref}
			class:list={[buttonClass, 'bg-blu hover:bg-blu/90']}
			target="_blank"
			rel="noopener noreferrer"
			data-cursor="target"
			aria-label={eventName ? `Volunteer at ${eventName}` : 'Volunteer'}
		>
			Volunteer
		</a>
		<a
			href={enterHref}
			class:list={[buttonClass, 'bg-volt hover:bg-volt/90']}
			target="_blank"
			rel="noopener noreferrer"
			data-cursor="target"
			aria-label={eventName ? `Enter ${eventName}` : 'Enter'}
		>
			Enter
		</a>
	</div>
</nav>
