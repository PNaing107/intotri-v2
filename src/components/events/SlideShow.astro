---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Event } from '../../data/events';

interface Props {
	images: Event['images'];
	alt: string;
	/** Milliseconds between automatic slide changes. */
	interval?: number;
}

const { images, alt, interval = 5000 } = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/**/*.{jpg,jpeg,png,webp,avif}',
);

const resolve = async (path: string) => {
	const key = `/${path.replace(/^\/+/, '')}`;
	const load = assets[key];
	if (!load) {
		throw new Error(`SlideShow: no image found at "${path}"`);
	}
	return (await load()).default;
};

const buildSrcset = async (path: string, widths: number[], ratio: number) => {
	const src = await resolve(path);
	const variants = await Promise.all(
		widths.map((width) =>
			getImage({
				src,
				width,
				height: Math.round(width * ratio),
				fit: 'cover',
				format: 'webp',
			}),
		),
	);
	const fallback = variants[variants.length - 1];

	return {
		src: fallback.src,
		srcset: variants.map((image, index) => `${image.src} ${widths[index]}w`).join(', '),
		width: fallback.attributes.width,
		height: fallback.attributes.height,
	};
};

const tracks = [
	{
		key: 'mobile',
		class: 'md:hidden',
		frame: 'aspect-[4/5]',
		sizes: '100vw',
		slides: await Promise.all(
			images.mobile.map((path) => buildSrcset(path, [480, 768, 1080], 5 / 4)),
		),
	},
	{
		key: 'desktop',
		class: 'hidden md:block',
		frame: 'aspect-[16/9]',
		sizes: '(min-width: 1680px) 1600px, 100vw',
		slides: await Promise.all(
			images.desktop.map((path) => buildSrcset(path, [960, 1600, 2400], 9 / 16)),
		),
	},
].filter((track) => track.slides.length > 0);

const pad = (value: number) => String(value).padStart(2, '0');
---

<div class="mt-10 md:mt-12" aria-roledescription="carousel" aria-label={alt}>
	{
		tracks.map((track) => (
			<div class:list={[track.class]} data-slideshow data-interval={interval}>
				<div class:list={['relative overflow-hidden bg-slatefriction', track.frame]}>
					{track.slides.map((slide, index) => (
						<img
							src={slide.src}
							srcset={slide.srcset}
							sizes={track.sizes}
							alt={`${alt} — photo ${index + 1} of ${track.slides.length}`}
							width={slide.width}
							height={slide.height}
							class="absolute inset-0 h-full w-full object-cover"
							loading="lazy"
							decoding="async"
							data-slide
							data-active={index === 0 ? '' : undefined}
							aria-hidden={index === 0 ? undefined : 'true'}
						/>
					))}

					{track.slides.length > 1 && (
						<>
							<div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-oxygen/40 to-transparent" />
							<p class="data-mono absolute bottom-0 left-0 px-4 pb-4 text-[11px] font-500 uppercase tracking-[0.22em] text-white md:px-6 md:pb-6">
								/ <span data-slide-index>01</span> — {pad(track.slides.length)}
							</p>
						</>
					)}
				</div>

				{track.slides.length > 1 && (
					<div class="mt-4 flex justify-center gap-2 md:mt-6">
						<button
							type="button"
							class="chrono-hover flex h-10 w-10 items-center justify-center bg-volt text-white hover:bg-blu md:h-12 md:w-12"
							aria-label="Previous photo"
							data-slide-prev
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m15 18-6-6 6-6" />
							</svg>
						</button>
						<button
							type="button"
							class="chrono-hover flex h-10 w-10 items-center justify-center bg-volt text-white hover:bg-blu md:h-12 md:w-12"
							aria-label="Next photo"
							data-slide-next
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m9 18 6-6-6-6" />
							</svg>
						</button>
					</div>
				)}
			</div>
		))
	}
</div>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		if (slides.length < 2) return;

		const counter = root.querySelector<HTMLElement>('[data-slide-index]');
		const interval = Number(root.dataset.interval) || 5000;
		let current = 0;
		let timer: number | undefined;
		let visible = false;
		let hovered = false;
		let focused = false;

		const show = (index: number) => {
			slides[current].removeAttribute('data-active');
			slides[current].setAttribute('aria-hidden', 'true');
			current = (index + slides.length) % slides.length;
			slides[current].setAttribute('data-active', '');
			slides[current].removeAttribute('aria-hidden');
			if (counter) counter.textContent = String(current + 1).padStart(2, '0');
		};

		const stop = () => {
			if (timer === undefined) return;
			window.clearInterval(timer);
			timer = undefined;
		};

		const sync = () => {
			const shouldRun = visible && !hovered && !focused && !document.hidden && !reduceMotion.matches;
			if (!shouldRun) return stop();
			if (timer !== undefined) return;
			timer = window.setInterval(() => show(current + 1), interval);
		};

		const step = (delta: number) => {
			show(current + delta);
			stop();
			sync();
		};

		root.querySelector('[data-slide-prev]')?.addEventListener('click', () => step(-1));
		root.querySelector('[data-slide-next]')?.addEventListener('click', () => step(1));

		root.addEventListener('pointerenter', () => {
			hovered = true;
			sync();
		});
		root.addEventListener('pointerleave', () => {
			hovered = false;
			sync();
		});
		root.addEventListener('focusin', () => {
			focused = true;
			sync();
		});
		root.addEventListener('focusout', () => {
			focused = false;
			sync();
		});

		document.addEventListener('visibilitychange', sync);

		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
			sync();
		}).observe(root);
	});
</script>

<style>
	[data-slide] {
		opacity: 0;
		transition: opacity 1200ms ease-in-out;
	}

	[data-slide][data-active] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-slide] {
			transition: none;
		}
	}
</style>
