---
import Layout from '../layouts/Layout.astro';
import ResultCard from '../components/intotri/ResultCard.astro';
import { resultYears } from '../data/results';

const years = resultYears.map(({ year, results }) => ({
	year,
	results: [...results].sort((a, b) => b.date.localeCompare(a.date)),
}));

const defaultYear = years[0]?.year ?? 2026;
const selectedClasses = ['bg-volt', 'text-white'];
const idleClasses = ['bg-transparent', 'text-oxygen'];
---

<Layout title="Results | IntoTri">
	<main>
		<section id="results-archive" class="surface-void px-5 pb-20 pt-28 md:px-10 md:pb-28 md:pt-36">
			<div class="mx-auto max-w-[1600px]">
				<div class="velocity-line"></div>

				<div class="py-10 md:py-12">
					<p class="data-mono mb-4 text-[10px] font-500 uppercase tracking-[0.22em] text-oxygen/70 md:text-[11px]">
						/ 01 — Archive
					</p>
					<h1 class="font-archive text-4xl font-900 uppercase leading-[0.86] tracking-tighter2 text-oxygen md:text-6xl">
						Results
					</h1>
					<p class="mt-6 max-w-2xl font-body text-[15px] leading-[1.6] text-oxygen/80 md:mt-8 md:text-lg">
						Times and rankings from the Cornish Tri Series and other IntoTri races. Open a result to view the full listing.
					</p>
					<div
						class="mt-6 inline-flex w-fit flex-wrap border border-[hsl(var(--oxygen)/0.12)] md:mt-8"
						role="group"
						aria-label="Filter results by year"
						data-year-filters
					>
						{
							years.map(({ year }) => {
								const selected = year === defaultYear;
								return (
									<button
										type="button"
										class:list={[
											'chrono-hover px-5 py-3 font-archive text-xs font-700 uppercase tracking-[0.18em]',
											selected ? selectedClasses : idleClasses,
										]}
										aria-pressed={selected ? 'true' : 'false'}
										data-filter={year}
										data-cursor="target"
									>
										{year}
									</button>
								);
							})
						}
					</div>
				</div>

				<div class="velocity-line"></div>

				<div class="pt-10 md:pt-12">
					{
						years.map(({ year, results }) => (
							<div
								class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
								aria-label={`${year} IntoTri results`}
								data-year={year}
								hidden={year !== defaultYear}
							>
								{results.map((result) => (
									<ResultCard result={result} />
								))}
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	const section = document.getElementById('results-archive');
	const buttons = section?.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const grids = section?.querySelectorAll<HTMLElement>('[data-year]');

	const selectedClasses = ['bg-volt', 'text-white'];
	const idleClasses = ['bg-transparent', 'text-oxygen'];

	function setYear(year: string) {
		buttons?.forEach((button) => {
			const selected = button.dataset.filter === year;
			button.setAttribute('aria-pressed', String(selected));
			button.classList.remove(...(selected ? idleClasses : selectedClasses));
			button.classList.add(...(selected ? selectedClasses : idleClasses));
		});

		grids?.forEach((grid) => {
			grid.hidden = grid.dataset.year !== year;
		});
	}

	buttons?.forEach((button) => {
		button.addEventListener('click', () => {
			const year = button.dataset.filter;
			if (year) setYear(year);
		});
	});
</script>
