---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/intotri/AboutHero.astro';
import teamPhoto from '../assets/intotri-team.jpg';
---

<Layout title="About | IntoTri">
	<main>
		<AboutHero />

		<section id="about" class="surface-void px-5 py-16 md:px-10 md:py-24">
			<div class="mx-auto max-w-[1600px]">
				<div class="velocity-line"></div>

				<div class="py-10 md:py-12">
					<p class="data-mono mb-4 text-[10px] font-500 uppercase tracking-[0.22em] text-oxygen/70 md:text-[11px]">
						/ 01 — About
					</p>
					<h1 class="font-archive text-4xl font-900 uppercase leading-[0.86] tracking-tighter2 text-oxygen md:text-6xl">
						Get Into Tri
					</h1>
					<h2 class="mt-6 max-w-3xl font-body text-[15px] leading-[1.6] text-oxygen/80 md:mt-8 md:text-lg">
						Open to all, affordable for everyone. Help intoTRI change the triathlon landscape and show our communities how being active leads to a healthier, happier life.
					</h2>
					<figure class="mt-8 w-fit max-w-full md:mt-12" style={`max-width: min(100%, ${teamPhoto.width}px)`}>
						<Image
							src={teamPhoto}
							alt="The IntoTri team together at a race, three athletes in kit with medals standing between two supporters"
							widths={[640, 960, 1280, 1600, 1920, 2560].filter((width) => width <= teamPhoto.width)}
							sizes={`(min-width: 768px) min(calc(100vw - 5rem), ${teamPhoto.width}px), min(calc(100vw - 2.5rem), ${teamPhoto.width}px)`}
							class="h-auto w-full max-w-full"
							loading="lazy"
						/>
						<figcaption class="mt-3 font-body text-[13px] leading-[1.6] text-oxygen/70 md:mt-4 md:text-[15px]">
							intoTRI is a registered charity, Charity Number 1163918
						</figcaption>
					</figure>
				</div>

				<div class="velocity-line"></div>
			</div>
		</section>
	</main>
</Layout>
