---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/intotri/EventCard.astro';
import { events } from '../data/events';

const calendar = [...events].sort((a, b) => a.date.localeCompare(b.date));
---

<Layout title="Events | IntoTri">
	<main>
		<section class="surface-void px-5 pb-20 pt-28 md:px-10 md:pb-28 md:pt-36">
			<div class="mx-auto max-w-[1600px]">
				<div class="velocity-line"></div>

				<div class="py-10 md:py-12">
					<p class="data-mono mb-4 text-[10px] font-500 uppercase tracking-[0.22em] text-oxygen/70 md:text-[11px]">
						/ 01 — Calendar
					</p>
					<h1 class="font-archive text-4xl font-900 uppercase leading-[0.86] tracking-tighter2 text-oxygen md:text-6xl">
						Events
					</h1>
					<p class="mt-6 max-w-xl font-body text-[15px] leading-[1.6] text-oxygen/80 md:mt-8 md:text-lg">
						Every IntoTri race for the season — senior and junior, swim to trail run. Pick your start line.
					</p>
				</div>

				<div class="velocity-line"></div>

				<div class="grid gap-6 pt-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 md:pt-12">
					{calendar.map((event) => <EventCard event={event} />)}
				</div>
			</div>
		</section>
	</main>
</Layout>
