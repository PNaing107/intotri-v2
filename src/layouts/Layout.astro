---
import '../index.css';
import SiteHeader from '../components/intotri/SiteHeader.astro';
import SiteFooter from '../components/intotri/SiteFooter.astro';
import { withBase } from '../lib/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<title>IntoTri</title>
	</head>
	<body class="min-h-full bg-void font-body text-oxygen antialiased">
		<SiteHeader />
		<slot />
		<SiteFooter />
	</body>
</html>
