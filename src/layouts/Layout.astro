---
import '../index.css';
import SiteHeader from '../components/intotri/SiteHeader.astro';
import SiteFooter from '../components/intotri/SiteFooter.astro';
import roundLogo from '../assets/intotri-round-logo.png';

interface Props {
	title?: string;
}

const { title = 'IntoTri' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={roundLogo.src} />
		<link rel="apple-touch-icon" href={roundLogo.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-full bg-void font-body text-oxygen antialiased">
		<SiteHeader />
		<slot />
		<SiteFooter />
	</body>
</html>
